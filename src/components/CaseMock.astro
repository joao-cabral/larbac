---
/**
 * Mocks animados e ilustrativos dos projetos (exceto Clickmax).
 * Nenhum dado real: apenas formas e textos genéricos.
 */
import type { CaseMockKind } from '../lib/case-mock';

interface Props { kind: CaseMockKind; }
const { kind } = Astro.props;

const theme: Record<CaseMockKind, string> = {
  checklist: 'repair', budget: 'repair', yard: 'repair', portal: 'repair',
  driver: 'routes', attendance: 'routes', admin: 'routes',
  bluetooth: 'iot', sensors: 'iot', monitor: 'iot',
  tests: 'qa', tool: 'qa',
  scan: 'libras', video: 'libras',
};
---

<div class={`case-mock case-mock--${theme[kind]} case-mock--${kind}`} aria-hidden="true">
  {kind === 'checklist' && (
    <div class="stack">
      <div class="head"><b class="mark">R</b><span>Checklist de entrada</span><em>Veículo</em></div>
      {['Lataria', 'Pneus', 'Painel', 'Combustível'].map((item, i) => (
        <div class="check" style={`--i:${i}`}><i></i><span>{item}</span><small></small></div>
      ))}
    </div>
  )}

  {kind === 'budget' && (
    <div class="stack">
      <div class="head"><b class="mark">R</b><span>Orçamento</span><em>Enviado</em></div>
      {[72, 54, 64].map((w, i) => (
        <div class="line-item" style={`--i:${i}`}><span style={`width:${w}%`}></span><b></b></div>
      ))}
      <div class="total"><span>Total</span><b></b></div>
      <div class="approve"><span>Aprovado pelo cliente</span><i>✓</i></div>
    </div>
  )}

  {kind === 'yard' && (
    <div class="board">
      {['Entrada', 'Execução', 'Pronto'].map((col, c) => (
        <div class="column">
          <span>{col}</span>
          {Array.from({ length: c === 1 ? 2 : 1 }).map(() => <div class="ticket"><b></b><i></i></div>)}
        </div>
      ))}
      <div class="ticket ticket--moving"><b></b><i></i></div>
    </div>
  )}

  {kind === 'portal' && (
    <div class="phone">
      <div class="phone__notch"></div>
      <strong>Seu veículo</strong>
      {['Recebido', 'Em serviço', 'Pronto para retirada'].map((step, i) => (
        <div class="status" style={`--i:${i}`}><i></i><span>{step}</span></div>
      ))}
    </div>
  )}

  {kind === 'driver' && (
    <div class="map">
      <svg viewBox="0 0 300 180" preserveAspectRatio="xMidYMid slice">
        <path class="street" d="M0 30H300M0 95H300M60 0V180M180 0V180M250 0V180" />
        <path class="route" d="M20 125 L60 95 L180 95 L180 30 L270 30" />
        <path class="route route--done" d="M20 125 L60 95 L180 95 L180 30 L270 30" />
        <circle class="stop" cx="60" cy="95" r="5" /><circle class="stop" cx="180" cy="95" r="5" /><circle class="stop" cx="180" cy="30" r="5" />
        <circle class="pin" cx="270" cy="30" r="7" />
      </svg>
      <div class="map__card"><b></b><span><strong>Próxima parada</strong><small>Itinerário designado</small></span></div>
    </div>
  )}

  {kind === 'attendance' && (
    <div class="stack">
      <div class="head"><b class="mark">◉</b><span>Paradas da rota</span><em>Ao vivo</em></div>
      {['Parada 1', 'Parada 2', 'Parada 3', 'Parada 4'].map((stop, i) => (
        <div class="attend" style={`--i:${i}`}><span class="avatar"></span><span>{stop}</span><em class={i === 2 ? 'absent' : ''}>{i === 2 ? 'Ausente' : 'Presente'}</em></div>
      ))}
    </div>
  )}

  {kind === 'admin' && (
    <div class="stack">
      <div class="head"><b class="mark">◉</b><span>Rotas em andamento</span><em>Admin</em></div>
      {[0, 1, 2].map(i => (
        <div class="route-row" style={`--i:${i}`}><span>Rota {String.fromCharCode(65 + i)}</span><i><b></b></i></div>
      ))}
      <div class="incident"><span>!</span>Ocorrência registrada</div>
    </div>
  )}

  {kind === 'bluetooth' && (
    <div class="pair">
      <div class="pair__phone"><span>App</span></div>
      <div class="pair__waves"><i></i><i></i><i></i></div>
      <div class="pair__board"><span>STM32</span><small></small></div>
      <div class="pair__steps"><span>Bluetooth</span><span>Wi-Fi</span><span>MQTT</span></div>
    </div>
  )}

  {kind === 'sensors' && (
    <div class="sensors">
      {[['Luminosidade', 70], ['Temperatura', 45], ['Ruído', 58], ['Umidade', 82]].map(([name, v], i) => (
        <div class="sensor" style={`--i:${i}; --v:${v}%`}><span>{name}</span><i><b></b></i></div>
      ))}
      <svg class="spark" viewBox="0 0 200 40" preserveAspectRatio="none"><path d="M0 30 L20 24 L40 28 L60 14 L80 20 L100 10 L120 18 L140 8 L160 16 L180 6 L200 12" /></svg>
    </div>
  )}

  {kind === 'monitor' && (
    <div class="lines">
      <div class="head"><b class="mark">◇</b><span>Linhas de produção</span><em>Tempo real</em></div>
      <div class="lines__grid">
        {Array.from({ length: 12 }).map((_, i) => <span class:list={['node', { 'node--warn': i === 7 }]} style={`--i:${i}`}><small>L{i + 1}</small><i></i></span>)}
      </div>
    </div>
  )}

  {kind === 'tests' && (
    <div class="stack">
      <div class="head"><b class="mark">▶</b><span>Execução de testes</span><em>Release</em></div>
      {['Conectividade', 'Câmera', 'Bateria', 'Notificações'].map((suite, i) => (
        <div class="suite" style={`--i:${i}`}><i></i><span>{suite}</span><b><em></em></b></div>
      ))}
    </div>
  )}

  {kind === 'tool' && (
    <div class="window">
      <div class="window__bar"><i></i><i></i><i></i><span>Ferramenta interna</span></div>
      <div class="window__body">
        <div class="field"><span>Resultados</span><b>relatorio_execucao.log</b></div>
        <div class="field"><span>Dispositivo</span><b>Modelo de teste · Android</b></div>
        <div class="submit"><span>Submeter</span><i class="spinner"></i><em>✓</em></div>
      </div>
    </div>
  )}

  {kind === 'scan' && (
    <div class="scan">
      <div class="scan__frame">
        <div class="qr">{Array.from({ length: 25 }).map((_, i) => <i class:list={{ on: [0, 1, 3, 5, 7, 8, 11, 12, 14, 16, 18, 20, 22, 23, 24].includes(i) }}></i>)}</div>
        <span class="scan__line"></span>
      </div>
      <p>Aponte para o QR Code da obra</p>
    </div>
  )}

  {kind === 'video' && (
    <div class="player">
      <div class="player__screen"><span class="signer"><i></i><b></b></span><span class="hand hand--l"></span><span class="hand hand--r"></span></div>
      <div class="player__bar"><b>▶</b><i><em></em></i></div>
      <p>Vídeo em Libras</p>
    </div>
  )}






</div>

<style>
  .case-mock {
    --bg: #101417; --panel: #182024; --line: #2c3a3c; --text: #e6efe9; --muted: #8fa199; --accent: #8de2b0; --ink: #172012;
    position: relative; overflow: hidden; height: 236px; padding: 18px; box-sizing: border-box;
    color: var(--text); background: var(--bg);
    background-image: radial-gradient(#ffffff0b 1px, transparent 1px); background-size: 18px 18px;
    font: 500 12px/1.4 Inter, system-ui, sans-serif;
  }
  .case-mock *, .case-mock *::before { box-sizing: border-box; }
  .case-mock i, .case-mock b, .case-mock em { font-style: normal; }
  .case-mock svg { display: block; }
  .case-mock--repair { --bg: #fff4eb; --panel: #fff; --line: #ecdccd; --text: #302a25; --muted: #8a7260; --accent: #ff783d; --ink: #fff; background-image: radial-gradient(#7a3b1210 1px, transparent 1px); }
  .case-mock--routes { --accent: #c5bbff; --panel: #1b1d2a; --line: #33364a; --bg: #121320; --ink: #1a1530; }
  .case-mock--iot { --accent: #8de2b0; --bg: #0f1814; --panel: #17231d; --line: #29392f; }
  .case-mock--qa { --accent: #e0e893; --bg: #13150f; --panel: #1d2017; --line: #343826; --ink: #23260f; }
  .case-mock--libras { --bg: #f2eefc; --panel: #fff; --line: #ddd4f2; --text: #2c2540; --muted: #82779c; --accent: #7a5cf0; --ink: #fff; background-image: radial-gradient(#3a1d8f0d 1px, transparent 1px); }

  .stack { display: flex; flex-direction: column; justify-content: center; gap: 7px; height: 100%; }
  .head { display: flex; align-items: center; gap: 8px; margin-bottom: 2px; font-weight: 650; }
  .head span { flex: 1; }
  .head em { padding: 2px 8px; border-radius: 999px; background: color-mix(in srgb, var(--accent) 18%, transparent); color: var(--accent); font-size: 10px; font-weight: 700; }
  .case-mock--repair .head em { color: #bc4c1c; }
  .mark { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 6px; background: var(--accent); color: var(--ink); font-size: 11px; font-weight: 800; }
  .case-mock--routes .mark, .case-mock--qa .mark { color: var(--ink); }

  /* RepareCar */
  .check { display: flex; align-items: center; gap: 9px; padding: 7px 10px; border: 1px solid var(--line); border-radius: 9px; background: var(--panel); }
  .check i { display: grid; place-items: center; width: 14px; height: 14px; border: 1.5px solid var(--line); border-radius: 4px; animation: tick 6s ease infinite; animation-delay: calc(var(--i) * .5s); }
  .check i::before { content: '✓'; color: #fff; font-size: 9px; font-weight: 800; }
  .check span { flex: 1; }
  .check small { width: 46px; height: 5px; border-radius: 3px; background: #efe4da; }
  .line-item { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 9px; background: var(--panel); opacity: 0; animation: appear 6s ease infinite; animation-delay: calc(var(--i) * .35s); }
  .line-item span { height: 5px; border-radius: 3px; background: #e7d8cb; }
  .line-item b { width: 34px; height: 6px; border-radius: 3px; background: #c9b3a1; }
  .total { display: flex; justify-content: space-between; align-items: center; padding: 2px 10px; color: var(--muted); font-weight: 650; }
  .total b { width: 52px; height: 9px; border-radius: 4px; background: #302a25; }
  .approve { display: flex; justify-content: space-between; align-items: center; padding: 7px 10px; border-radius: 9px; background: #e9f3e3; color: #3e6b2f; font-weight: 650; opacity: 0; animation: approve 6s ease infinite; }
  .approve i { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: #5d9a46; color: #fff; font-size: 10px; }
  .board { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; height: 100%; }
  .column { display: flex; flex-direction: column; gap: 7px; padding: 8px; border-radius: 10px; background: #f6ebe1; }
  .column > span { color: var(--muted); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .ticket { display: grid; gap: 5px; padding: 8px; border: 1px solid var(--line); border-radius: 8px; background: #fff; }
  .ticket b { width: 70%; height: 6px; border-radius: 3px; background: #3c332c; }
  .ticket i { width: 45%; height: 5px; border-radius: 3px; background: #f4b88f; }
  .ticket--moving { position: absolute; left: 8px; top: 32px; width: calc(33.3% - 21px); box-shadow: 0 8px 18px #7a3b1222; animation: move-card 7s ease-in-out infinite; }
  .phone { display: flex; flex-direction: column; gap: 9px; width: 58%; height: calc(100% + 30px); margin: 0 auto; padding: 22px 14px; border: 1px solid var(--line); border-radius: 22px; background: var(--panel); box-shadow: 0 10px 28px #7a3b1218; }
  .phone__notch { position: absolute; left: 50%; top: 24px; width: 44px; height: 5px; border-radius: 3px; background: #eadbcf; transform: translateX(-50%); }
  .phone strong { font-size: 13px; }
  .status { display: flex; align-items: center; gap: 9px; color: var(--muted); animation: status 7s ease infinite; animation-delay: calc(var(--i) * 1.2s); }
  .status i { width: 12px; height: 12px; border: 2px solid var(--line); border-radius: 50%; }

  /* Rotas */
  .map { position: absolute; inset: 0; }
  .map svg { width: 100%; height: 100%; }
  .street { fill: none; stroke: #23263a; stroke-width: 12; }
  .route { fill: none; stroke: #3a3d58; stroke-width: 4; stroke-linejoin: round; }
  .route--done { stroke: var(--accent); stroke-dasharray: 460; stroke-dashoffset: 460; animation: draw 6s ease-in-out infinite; }
  .stop { fill: var(--bg); stroke: var(--accent); stroke-width: 2; }
  .pin { fill: var(--accent); animation: pulse 2s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .map__card { position: absolute; left: 14px; right: 14px; bottom: 14px; display: flex; align-items: center; gap: 10px; padding: 9px; border: 1px solid var(--line); border-radius: 10px; background: #1b1d2aee; }
  .map__card b { width: 28px; height: 28px; border-radius: 8px; background: linear-gradient(135deg, #8cc8f0, var(--accent)); }
  .map__card span { display: grid; }
  .map__card small { color: var(--muted); font-size: 10px; }
  .attend { display: flex; align-items: center; gap: 9px; padding: 6px 10px; border: 1px solid var(--line); border-radius: 9px; background: var(--panel); opacity: 0; animation: appear 6s ease infinite; animation-delay: calc(var(--i) * .4s); }
  .attend span:nth-child(2) { flex: 1; }
  .attend em { color: #9be3b4; font-size: 10px; font-weight: 700; }
  .attend em.absent { color: #f2a27a; }
  .avatar { width: 18px; height: 18px; border-radius: 50%; background: linear-gradient(135deg, #8cc8f0, var(--accent)); }
  .route-row { display: grid; grid-template-columns: 52px 1fr; align-items: center; gap: 10px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 9px; background: var(--panel); }
  .route-row i { height: 6px; border-radius: 9px; background: var(--line); overflow: hidden; }
  .route-row i b { display: block; height: 100%; background: var(--accent); animation: grow 6s ease-in-out infinite; animation-delay: calc(var(--i) * -1.5s); }
  .incident { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 9px; background: #3a2620; color: #f6c0a4; animation: blink 6s ease infinite; }
  .incident span { display: grid; place-items: center; width: 16px; height: 16px; border-radius: 50%; background: #f2a27a; color: #3a2620; font-weight: 800; font-size: 10px; }

  /* IoT */
  .pair { display: grid; grid-template-columns: 1fr auto 1fr; grid-template-rows: 1fr auto; align-items: center; gap: 12px; height: 100%; }
  .pair__phone, .pair__board { display: grid; place-items: center; height: 110px; border: 1px solid var(--line); border-radius: 14px; background: var(--panel); color: var(--muted); font-weight: 650; }
  .pair__phone { width: 64px; justify-self: end; border-radius: 16px; }
  .pair__board { width: 110px; height: 80px; justify-self: start; border-color: #3d5a48; background: repeating-linear-gradient(90deg, #17231d 0 10px, #1b2a22 10px 11px); color: var(--accent); }
  .pair__board small { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); animation: blink 1.4s ease infinite; }
  .pair__waves { display: flex; gap: 4px; }
  .pair__waves i { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); opacity: .2; animation: wave 1.5s ease infinite; }
  .pair__waves i:nth-child(2) { animation-delay: .2s; } .pair__waves i:nth-child(3) { animation-delay: .4s; }
  .pair__steps { grid-column: 1 / -1; display: flex; gap: 6px; }
  .pair__steps span { flex: 1; padding: 5px 0; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font-size: 10px; text-align: center; animation: step-on 6s ease infinite; }
  .pair__steps span:nth-child(2) { animation-delay: 1.2s; } .pair__steps span:nth-child(3) { animation-delay: 2.4s; }
  .sensors { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; height: 100%; align-content: center; }
  .sensor { display: grid; gap: 8px; padding: 10px; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); color: var(--muted); font-size: 11px; }
  .sensor i { height: 6px; border-radius: 9px; background: var(--line); overflow: hidden; }
  .sensor i b { display: block; width: var(--v); height: 100%; background: var(--accent); animation: jitter 2.4s ease-in-out infinite; animation-delay: calc(var(--i) * -.6s); transform-origin: left; }
  .spark { grid-column: 1 / -1; width: 100%; height: 40px; }
  .spark path { fill: none; stroke: var(--accent); stroke-width: 2; stroke-dasharray: 260; stroke-dashoffset: 260; animation: draw-spark 6s ease-out infinite; }
  .lines { display: flex; flex-direction: column; justify-content: center; gap: 12px; height: 100%; }
  .lines__grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; }
  .node { aspect-ratio: 1; border: 1px solid var(--line); border-radius: 9px; background: var(--panel); position: relative; }
  .node::after { content: ''; position: absolute; right: 6px; top: 6px; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); animation: blink 2.4s ease infinite; animation-delay: calc(var(--i) * .2s); }
  .node small { position: absolute; left: 7px; top: 5px; color: var(--muted); font-size: 9px; font-weight: 700; }
  .node i { position: absolute; left: 7px; right: 7px; bottom: 7px; height: 4px; border-radius: 3px; background: color-mix(in srgb, var(--accent) 45%, transparent); }
  .node--warn i { background: #f2c86b88; }
  .node--warn { border-color: #6a5a2c; } .node--warn::after { background: #f2c86b; }

  /* Sidia */
  .suite { display: grid; grid-template-columns: 14px 1fr 70px; align-items: center; gap: 9px; padding: 7px 10px; border: 1px solid var(--line); border-radius: 9px; background: var(--panel); }
  .suite > i { width: 10px; height: 10px; border-radius: 50%; background: var(--line); animation: pass 6s ease infinite; animation-delay: calc(var(--i) * .7s); }
  .suite b { height: 5px; border-radius: 9px; background: var(--line); overflow: hidden; }
  .suite b em { display: block; height: 100%; width: 0; background: var(--accent); animation: run 6s ease infinite; animation-delay: calc(var(--i) * .7s); }
  .window { height: 100%; overflow: hidden; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); }
  .window__bar { display: flex; align-items: center; gap: 5px; padding: 8px 10px; border-bottom: 1px solid var(--line); color: #c9cdb5; font-size: 11px; }
  .window__bar i { width: 8px; height: 8px; border-radius: 50%; background: #5d6247; }
  .window__bar span { margin-left: 6px; }
  .window__body { display: grid; gap: 10px; padding: 14px; }
  .field { display: grid; gap: 5px; color: #b2b89c; font-size: 10px; }
  .field b { display: flex; align-items: center; height: 24px; padding: 0 8px; border: 1px solid var(--line); border-radius: 7px; background: #15170f; color: #c9cdb5; font-size: 11px; font-weight: 500; }
  .submit { position: relative; display: flex; justify-content: center; align-items: center; height: 30px; border-radius: 8px; background: var(--accent); color: var(--ink); font-weight: 750; overflow: hidden; }
  .submit span { animation: label 5s ease infinite; }
  .spinner { position: absolute; width: 14px; height: 14px; border: 2px solid #23260f55; border-top-color: var(--ink); border-radius: 50%; opacity: 0; animation: spinner-show 5s ease infinite, spin .8s linear infinite; }
  .submit em { position: absolute; opacity: 0; animation: done 5s ease infinite; }

  /* LibrasCode */
  .scan { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; height: 100%; }
  .scan__frame { position: relative; padding: 14px; border-radius: 16px; background: var(--panel); box-shadow: 0 8px 22px #3a1d8f14; }
  .scan__frame::before { content: ''; position: absolute; inset: 4px; border: 2px solid var(--accent); border-radius: 12px; clip-path: polygon(0 0, 25% 0, 25% 4px, 4px 4px, 4px 25%, 0 25%, 0 75%, 4px 75%, 4px calc(100% - 4px), 25% calc(100% - 4px), 25% 100%, 75% 100%, 75% calc(100% - 4px), calc(100% - 4px) calc(100% - 4px), calc(100% - 4px) 75%, 100% 75%, 100% 25%, calc(100% - 4px) 25%, calc(100% - 4px) 4px, 75% 4px, 75% 0, 100% 0, 100% 100%, 0 100%); }
  .qr { display: grid; grid-template-columns: repeat(5, 18px); gap: 3px; }
  .qr i { height: 18px; border-radius: 3px; background: #ece7f8; }
  .qr i.on { background: #2c2540; }
  .scan__line { position: absolute; left: 10px; right: 10px; top: 14px; height: 2px; background: var(--accent); box-shadow: 0 0 12px var(--accent); animation: scan 2.6s ease-in-out infinite; }
  .scan p, .player p { margin: 0; color: #4b4163; font-size: 12px; font-weight: 600; }
  .player { display: flex; flex-direction: column; justify-content: center; gap: 10px; height: 100%; }
  .player__screen { position: relative; height: 140px; border-radius: 12px; background: linear-gradient(160deg, #3b2f66, #241c40); overflow: hidden; }
  .signer { position: absolute; left: 50%; bottom: 0; display: grid; justify-items: center; transform: translateX(-50%); }
  .signer i { width: 34px; height: 34px; border-radius: 50%; background: #d8cdf7; }
  .signer b { width: 90px; height: 60px; margin-top: 4px; border-radius: 40px 40px 0 0; background: #8f7ae8; }
  .hand { position: absolute; bottom: 52px; width: 18px; height: 22px; border-radius: 9px; background: #d8cdf7; }
  .hand--l { left: calc(50% - 46px); animation: sign-l 1.8s ease-in-out infinite; }
  .hand--r { left: calc(50% + 28px); animation: sign-r 1.8s ease-in-out infinite; }
  .player__bar { display: flex; align-items: center; gap: 10px; padding: 0 2px; }
  .player__bar b { color: var(--accent); }
  .player__bar i { flex: 1; height: 5px; border-radius: 9px; background: var(--line); overflow: hidden; }
  .player__bar em { display: block; height: 100%; width: 0; background: var(--accent); animation: grow 6s linear infinite; }


  @keyframes tick { 0%, 8% { background: transparent; border-color: var(--line); } 14%, 92% { background: #5d9a46; border-color: #5d9a46; } 100% { background: transparent; } }
