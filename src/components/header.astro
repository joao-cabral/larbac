---
import { Icon } from "astro-icon/components";

const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const links = [
  { label: "Trabalhos", href: "/trabalhos" },
  { label: "Posts", href: "/posts" },
  { label: "Uses", href: "/uses" },
];

const isActive = (href: string) =>
  pathname.startsWith(href) ||
  (href === "/trabalhos" && pathname.startsWith("/projects"));
---

<header class="site-header">
  <div class:list={["site-header__inner", { "is-home": isHome }]}>
    {!isHome && (
      <a class="brand" href="/" aria-label="Ir para a página inicial">
        <span class="brand__mark">JC</span>
        <span>João Cabral</span>
      </a>
    )}

    <nav aria-label="Navegação principal">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={{ active: isActive(link.href) }}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
      <a
        class="source-link"
        href="https://github.com/joao-cabral"
        target="_blank"
        rel="noreferrer"
      >
        <Icon name="mdi:github" />
        <span>Source</span>
      </a>
    </nav>
  </div>
</header>

<style lang="scss">
  :global(:root) {
    --site-header-height: 88px;
  }

  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    height: var(--site-header-height);
    // border-bottom: 1px solid #dedfd9;
    background: rgba(244, 245, 242, 0.92);
    backdrop-filter: blur(16px);
  }

  .site-header__inner {
    width: min(1580px, 100%);
    height: 100%;
    margin: 0 auto;
    padding: 0 clamp(24px, 4vw, 72px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .site-header__inner.is-home {
    justify-content: flex-end;
  }

  .site-header__inner * {
    font-family: inherit;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    color: #171816;
    font-size: 1rem;
    font-weight: 780;
    letter-spacing: -0.03em;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: #171816;
    color: #fff;
    font-size: 0.7rem;
    letter-spacing: -0.04em;
  }

  nav {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  nav a {
    height: 46px;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border-radius: 12px;
    color: #30332f;
    font-size: 0.9rem;
    font-weight: 620;
    text-decoration: none;
    transition: background 160ms ease, color 160ms ease;
  }

  nav a:hover {
    background: #e8eae5;
  }

  nav a.active {
    background: #ccebea;
    color: #165f60;
  }

  .source-link svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 680px) {
    :global(:root) {
      --site-header-height: 72px;
    }

    :global(body) {
      padding-top: var(--site-header-height);
    }

    .site-header {
      position: fixed;
      right: 0;
      left: 0;
    }

    .site-header__inner {
      padding: 0 16px;
      gap: 12px;
    }

    .brand > span:last-child,
    .source-link span {
      display: none;
    }

    nav {
      gap: 2px;
    }

    nav a {
      height: 40px;
      padding: 0 10px;
      font-size: 0.78rem;
    }
  }

  @media (max-width: 390px) {
    .brand__mark {
      width: 32px;
      height: 32px;
    }

    nav a {
      padding: 0 7px;
      font-size: 0.72rem;
    }

    .source-link {
      display: none;
    }
  }

  @media print {
    .site-header {
      display: none;
    }
  }
</style>
