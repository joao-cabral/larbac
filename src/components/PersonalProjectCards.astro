---
import PersonalProjectIllustration from "./PersonalProjectIllustration.astro";
import LearningProjectIllustration from "./LearningProjectIllustration.astro";
interface Props { limit?: number; wide?: boolean; }
const { limit, wide = false } = Astro.props;
const allProjects = [
  { title: "issoeseu · Ar Manaus", category: "Dados abertos · Meio ambiente", description: "Qualidade do ar em Manaus em um mapa: sensores, previsão de fumaça e dados ambientais para entender o que estamos respirando.", href: "https://ar.issoeseu.com/", flow: "air" as const, theme: "air" },
  { title: "Cabral 3D Lab", category: "Impressão 3D · E-commerce", description: "Da ideia ao objeto: uma loja de criações em impressão 3D, com brinquedos sensoriais, peças decorativas e novas formas de explorar.", href: "https://shop.cabral3dlab.com/", flow: "print" as const, theme: "print" },
  { title: "Tabela de Schulte", category: "Jogo de atenção", description: "Um exercício de concentração, percepção periférica e velocidade mental. Encontre os números em ordem crescente.", href: "/games/schulte-table", flow: "schulte" as const, theme: "game" },
  { title: "LibrasCode", category: "Acessibilidade · Flutter", description: "QR Codes conectam espaços culturais a vídeos em Libras, ampliando a acessibilidade e a autonomia de pessoas surdas.", href: "/projects/librascode-project", flow: "libras" as const, theme: "libras" },
];
const projects = limit === undefined ? allProjects : allProjects.slice(0, limit);
---
{projects.map(project => (
  <a class:list={['personal-card', `personal-card--${project.theme}`, { 'personal-card--wide': wide }]} href={project.href} target={project.href.startsWith('https://') ? '_blank' : undefined} rel={project.href.startsWith('https://') ? 'noopener noreferrer' : undefined}>
    {project.flow === 'air' || project.flow === 'print'
      ? <PersonalProjectIllustration kind={project.flow} />
      : <LearningProjectIllustration kind={project.flow} />}
    <div class="personal-card__body">
      <p class="personal-card__category">{project.category}</p>
      <h3>{project.title}<span aria-hidden="true">↗</span></h3>
      <p>{project.description}</p>
      <span class="personal-card__link">Explorar projeto <span aria-hidden="true">→</span></span>
    </div>
  </a>
))}
<style>
  .personal-card { display: flex; flex-direction: column; overflow: hidden; border: 1px solid #d4e2d9; border-radius: 28px; background: #eaf3ed; color: #171816; text-decoration: none; transition: transform 220ms ease, box-shadow 220ms ease; }
  .personal-card--print { background: #fbefe3; border-color: #e9d8c8; }
  .personal-card--game { background: #121b18; border-color: #344e3d; color: #edf5ed; }
  .personal-card--libras { background: #eae5fb; border-color: #d9d0ed; }
  .personal-card--wide { grid-column: 1 / -1; min-width: 0; }
  .personal-card:hover { transform: translateY(-4px); box-shadow: 0 22px 48px #2529241c; }
  .personal-card__body { display: flex; flex-direction: column; flex: 1; padding: 24px; }
  .personal-card__category { margin: 0 0 12px; color: #42614d; font-size: .65rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .personal-card--print .personal-card__category { color: #80542e; }
  .personal-card--game .personal-card__category { color: #a5d4ad; }
  .personal-card--libras .personal-card__category { color: #705c97; }
  h3 { display: flex; justify-content: space-between; gap: 12px; margin: 0; font-size: 1.45rem; line-height: 1.15; letter-spacing: -.04em; }
  .personal-card__body > p:not(.personal-card__category) { margin: 12px 0 24px; color: #59635b; font-size: .88rem; line-height: 1.6; }
  .personal-card--print .personal-card__body > p:not(.personal-card__category) { color: #716052; }
  .personal-card--game .personal-card__body > p:not(.personal-card__category) { color: #adbdaf; }
  .personal-card--libras .personal-card__body > p:not(.personal-card__category) { color: #6e6680; }
  .personal-card__link { margin-top: auto; display: flex; justify-content: space-between; font-size: .76rem; font-weight: 650; }
  .personal-card:focus-visible { outline: 3px solid #258753; outline-offset: 4px; }
  @container (min-width: 600px) {
    .personal-card--wide { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); }
    .personal-card--wide > :global(svg) { align-self: center; }
    .personal-card--wide .personal-card__body { min-width: 0; padding: clamp(24px, 3vw, 36px); }
  }
  @media (max-width: 760px) { .personal-card { border-radius: 22px; } }
  @media (prefers-reduced-motion: reduce) { .personal-card { transition: none; } }
</style>
