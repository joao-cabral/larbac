---
import { Icon } from "astro-icon/components";
const technologies = [
  { name: "React", icon: "react", color: "#087ea4" },
  { name: "TypeScript", icon: "typescript", color: "#3178c6" },
  { name: "Flutter", icon: "flutter", color: "#027dba" },
  { name: "Angular", icon: "angular", color: "#dd0031" },
  { name: "Node.js", icon: "nodedotjs", color: "#43853d" },
  { name: "PostgreSQL", icon: "postgresql", color: "#4169a1" },
];
---
<section class="technology-strip" aria-labelledby="technology-heading">
  <div class="technology-copy">
    <p>Principais tecnologias</p>
    <h2 id="technology-heading">Ferramentas que uso para construir</h2>
  </div>
  <ul class="technology-icons" role="list">
    {technologies.map(technology => (
      <li class="technology-icon" tabindex="0" aria-label={technology.name} style={`--icon-color: ${technology.color}`}>
        <Icon name={`simple-icons:${technology.icon}`} aria-hidden="true" />
      </li>
    ))}
  </ul>
</section>
<style>
  .technology-strip { padding: clamp(22px, 3vw, 32px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; }
  .technology-copy { flex: 1 1 200px; }
  .technology-copy p { margin: 0 0 10px; color: #6d716b; font-size: .68rem; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
  .technology-copy h2 { max-width: 320px; margin: 0; font-size: clamp(1.3rem, 2vw, 1.8rem); letter-spacing: -.045em; line-height: 1.1; }
  .technology-icons { flex: 1 1 380px; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; padding: 0; margin: 0; list-style: none; }
  .technology-icon { position: relative; min-width: 0; padding: 16px 5px; display: grid; place-items: center; }
  .technology-icon :global(svg) { display: block; width: 30px; height: 30px; color: var(--icon-color); }
  .technology-icon::after {
    content: attr(aria-label);
    position: absolute;
    z-index: 2;
    top: calc(100% - 2px);
    left: 50%;
    padding: 5px 9px;
    border-radius: 6px;
    background: #171e19;
    color: #fff;
    font-size: .65rem;
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translate(-50%, -4px);
    transition: opacity 150ms ease, transform 150ms ease, visibility 150ms;
  }
  .technology-icon:hover::after,
  .technology-icon:focus-visible::after {
    visibility: visible;
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .technology-icon:focus-visible { outline: 2px solid var(--icon-color); outline-offset: 2px; }

  @media (hover: hover) and (pointer: fine) {
    :global(.card--skills) .technology-strip {
      max-height: 0;
      padding-top: 0;
      padding-bottom: 0;
      overflow: hidden;
      opacity: 0;
      pointer-events: none;
      transition: max-height 520ms cubic-bezier(.22, 1, .36, 1),
        padding 520ms cubic-bezier(.22, 1, .36, 1), opacity 360ms ease;
    }
    :global(.card--skills:hover) .technology-strip,
    :global(.card--skills:focus-within) .technology-strip {
      max-height: 320px;
      padding-top: clamp(22px, 3vw, 32px);
      padding-bottom: clamp(22px, 3vw, 32px);
      opacity: 1;
      pointer-events: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.card--skills) .technology-strip { transition: none; }
    .technology-icon::after { transition: none; }
  }

  @media (max-width: 480px) { .technology-icons { flex-basis: 100%; grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
