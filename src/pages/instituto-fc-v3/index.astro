---
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';

const foods = [
	{ name: 'Abacate', icon: 'favorite', image: 'avocado.jpg', description: 'Rico em gorduras boas e fibras. Auxilia na saúde do coração e controle do colesterol.' },
	{ name: 'Salmão', icon: 'waves', image: 'salmon.jpg', description: 'Fonte de ômega 3 e proteínas de alta qualidade. Reduz inflamações e favorece o cérebro.' },
	{ name: 'Nozes', icon: 'psychology', image: 'walnuts.jpg', description: 'Ricas em selênio e antioxidantes. Cruciais para a saúde cognitiva e proteção celular.' },
	{ name: 'Chia', icon: 'energy_savings_leaf', image: 'chia.jpg', description: 'Promove saciedade e equilíbrio intestinal. Rica em fibras e minerais essenciais.' },
];

const mobileFoods = [
	{ name: 'Abacate', tag: 'Gorduras Boas', image: 'mobile-avocado.jpg', description: 'Rico em ácido oleico e glutationa para saúde mitocondrial.' },
	{ name: 'Salmão Selvagem', tag: 'Ômega 3', image: 'mobile-salmon.jpg', description: 'Fonte essencial de EPA/DHA para redução de inflamação sistêmica.' },
	{ name: 'Frutas Vermelhas', tag: 'Antioxidantes', image: 'mobile-berries.jpg', description: 'Polifenóis que combatem o estresse oxidativo e otimizam a cognição.' },
	{ name: 'Cacau 85%', tag: 'Flavonóides', image: 'mobile-cacao.jpg', description: 'Magnésio e teobromina para saúde cardiovascular e foco.' },
];
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Nutrição baseada em evidências para equilíbrio, performance e longevidade." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Material+Symbols+Outlined:opsz,wght,FILL@24,300,0&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet" />
		<title>Instituto FC | Nutrição e Bem-estar</title>
		<GoogleAnalytics />
	</head>
	<body>
		<header class="site-header">
			<div class="container nav-wrap">
				<a class="brand" href="#inicio">Instituto FC</a>
				<nav aria-label="Navegação principal"><a class="active" href="#inicio">Home</a><a href="#alimentos">Especialidades</a><a href="#hidratacao">Sobre</a><a href="#hidratacao">Ciência</a><a href="#protocolo">Suplementos</a></nav>
				<a class="button button-small" href="#protocolo">Marcar Consulta</a>
				<button class="mobile-menu" type="button" aria-label="Abrir menu"><span class="material-symbols-outlined">menu</span></button>
			</div>
		</header>

		<main class="desktop-v3">
			<section class="hero" id="inicio">
				<div class="hero-bg"></div>
				<div class="container hero-content">
					<div class="hero-copy reveal">
						<span class="tag">Ciência &amp; Bem-estar</span>
						<h1>Nutrição que Alimenta sua Vida</h1>
						<p>Plano nutricional baseado em evidências para equilíbrio e longevidade. Transforme sua saúde com o acompanhamento do Instituto FC.</p>
						<div class="actions"><a class="button" href="#protocolo">Agendar avaliação</a><a class="button button-outline" href="#alimentos">Conhecer protocolos</a></div>
					</div>
				</div>
				<aside class="method-card"><div><span class="material-symbols-outlined">verified_user</span><strong>Metodologia Exclusiva</strong></div><p>Protocolos individuais focados em performance e biologia molecular.</p></aside>
			</section>

			<section class="section foods" id="alimentos">
				<div class="container">
					<header class="section-heading reveal"><h2>Superalimentos: Base do Equilíbrio</h2><p>A verdadeira nutrição começa com escolhas conscientes que respeitam a fisiologia do seu corpo.</p></header>
					<div class="food-grid">
						{foods.map((food) => (
							<article class="food-card reveal">
								<div class="food-image"><img src={`/images/instituto-fc-v3/${food.image}`} alt={food.name} /></div>
								<h3><span class="material-symbols-outlined filled">{food.icon}</span>{food.name}</h3>
								<p>{food.description}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="section hydration" id="hidratacao">
				<div class="container hydration-grid">
					<div class="hydration-visual reveal">
						<img src="/images/instituto-fc-v3/hydration.jpg" alt="Água com limão e folhas de hortelã" />
						<div class="image-label"><span class="material-symbols-outlined">water_drop</span><small>Vitalidade Diária</small></div>
					</div>
					<div class="hydration-copy reveal">
						<h2>Hidratar é cuidar de você</h2>
						<p>A água é o condutor de todas as funções biológicas. No Instituto FC, tratamos a hidratação como um pilar fundamental da performance cognitiva e metabólica.</p>
						<ul><li><span class="material-symbols-outlined filled">check_circle</span>Melhora a clareza mental e foco</li><li><span class="material-symbols-outlined filled">check_circle</span>Auxilia no transporte de nutrientes</li><li><span class="material-symbols-outlined filled">check_circle</span>Essencial para a regeneração celular</li></ul>
						<blockquote>“Pequenas escolhas fazem grandes transformações.”</blockquote>
					</div>
				</div>
			</section>

			<section class="section protocol-section" id="protocolo">
				<div class="container protocol reveal">
					<h2>Inicie seu Protocolo de Longevidade</h2>
					<p>Nossa equipe está pronta para desenhar seu mapa nutricional personalizado. Vagas limitadas para acompanhamento mensal.</p>
					<form id="contact-form"><input required name="name" placeholder="Seu nome completo" /><input required type="email" name="email" placeholder="E-mail profissional" /><button type="submit">Solicitar contato</button></form>
					<small class="form-message" aria-live="polite">Resposta em até 24h úteis.</small>
				</div>
			</section>
		</main>

		<main class="mobile-v3">
			<section class="mv3-hero" id="mv3-inicio"><div class="mv3-hero-bg"></div><div class="mv3-shell mv3-hero-copy"><span>Performance Humana</span><h1>Nutrição que Alimenta sua Vida</h1><p>Descubra como a medicina de precisão e a nutrologia podem transformar seu desempenho e longevidade.</p><div><a href="#mv3-newsletter">Comece agora</a><a href="#mv3-alimentos">Ver Vídeo <span class="material-symbols-outlined">arrow_forward</span></a></div></div></section>
			<section class="mv3-section mv3-foods" id="mv3-alimentos"><div class="mv3-shell"><header><h2>Superalimentos e Nutrientes Chave</h2><p>Uma curadoria científica dos pilares alimentares que compõem nosso protocolo de alta performance.</p><div><button class="mv3-scroll-prev" type="button" aria-label="Anterior"><span class="material-symbols-outlined">chevron_left</span></button><button class="mv3-scroll-next" type="button" aria-label="Próximo"><span class="material-symbols-outlined">chevron_right</span></button></div></header><div class="mv3-food-scroll">{mobileFoods.map((food) => <article><img src={`/images/instituto-fc-v3/${food.image}`} alt={food.name} /><small>{food.tag}</small><h3>{food.name}</h3><p>{food.description}</p></article>)}</div></div></section>
			<section class="mv3-section mv3-hydration" id="mv3-hidratacao"><div class="mv3-shell"><img src="/images/instituto-fc-v3/mobile-hydration.jpg" alt="Água com limão e hortelã" /><div class="mv3-hydration-copy"><div class="mv3-hydration-label"><span class="material-symbols-outlined">water_drop</span><small>Hidratação Celular</small></div><h2>Hidratar é cuidar de você</h2><p>A água não é apenas um solvente; é o meio pelo qual toda a vida celular acontece. Nosso protocolo de hidratação otimiza o transporte de nutrientes e a eliminação de toxinas.</p><blockquote><span class="material-symbols-outlined">eco</span>“Pequenas escolhas fazem grandes transformações no seu metabolismo basal.”</blockquote><a href="#mv3-newsletter">Protocolos de Hidratação</a></div></div></section>
			<section class="mv3-section mv3-science" id="mv3-ciencia"><div class="mv3-shell"><header><h2>Ciência Aplicada</h2><p>Trabalhamos apenas com o que há de mais avançado em evidências clínicas para suplementação e performance humana.</p></header><div class="mv3-benefits"><article><span class="material-symbols-outlined">neurology</span><h3>Saúde Cognitiva</h3><p>Otimização de neurotransmissores e neuroplasticidade através de nootrópicos naturais e sono regenerativo.</p></article><article><span class="material-symbols-outlined">favorite</span><h3>Cardiometabolismo</h3><p>Gestão de glicemia, perfil lipídico e saúde do endotélio para uma vida longa e ativa.</p></article><article><span class="material-symbols-outlined">fitness_center</span><h3>Performance Muscular</h3><p>Manutenção de massa magra e densidade óssea através de protocolos proteicos e exercícios de força.</p></article></div></div></section>
			<section class="mv3-newsletter" id="mv3-newsletter"><div class="mv3-shell"><h2>Receba Insights de Performance</h2><p>Assine nossa newsletter exclusiva com conteúdos científicos e dicas práticas para otimizar sua rotina de bem-estar.</p><form id="mobile-newsletter"><input required type="email" placeholder="Seu melhor e-mail" /><button type="submit">Inscrever-se</button><small aria-live="polite">Respeitamos sua privacidade. Cancele a qualquer momento.</small></form></div></section>
		</main>

		<footer class="footer">
			<div class="container footer-wrap"><div><span class="brand">Instituto FC</span><small>© 2026 Instituto FC. Nutrologia e Performance Humana.</small></div><nav><a href="#">Termos de Uso</a><a href="#">Privacidade</a><a href="#">FAQ</a><a href="#protocolo">Contato</a></nav><div class="footer-icons"><a href="#" aria-label="Site"><span class="material-symbols-outlined">language</span></a><a href="mailto:contato@institutofc.com.br" aria-label="E-mail"><span class="material-symbols-outlined">mail</span></a></div></div>
		</footer>
		<a class="fab" href="#protocolo" aria-label="Agendar agora"><span class="material-symbols-outlined filled">calendar_month</span><span>Agendar Agora</span></a>
		<nav class="mobile-bottom-nav" aria-label="Navegação mobile"><a class="active" href="#mv3-inicio"><span class="material-symbols-outlined filled">home</span><small>Início</small></a><a href="#mv3-alimentos"><span class="material-symbols-outlined">menu_book</span><small>Protocolos</small></a><a href="#mv3-ciencia"><span class="material-symbols-outlined">science</span><small>Ciência</small></a><a href="#mv3-newsletter"><span class="material-symbols-outlined">person</span><small>Perfil</small></a></nav>

		<script>
			const observer = new IntersectionObserver((entries) => entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add('visible')), { threshold: .12 });
			document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
			const form = document.querySelector<HTMLFormElement>('#contact-form');
			form?.addEventListener('submit', (event) => {
				event.preventDefault();
				form.reset();
				const message = document.querySelector<HTMLElement>('.form-message');
				if (message) message.textContent = 'Solicitação enviada. Em breve entraremos em contato.';
			});
			const mobileNewsletter = document.querySelector<HTMLFormElement>('#mobile-newsletter');
			mobileNewsletter?.addEventListener('submit', (event) => { event.preventDefault(); mobileNewsletter.reset(); const message = mobileNewsletter.querySelector('small'); if (message) message.textContent = 'Inscrição realizada com sucesso.'; });
			const foodScroll = document.querySelector<HTMLElement>('.mv3-food-scroll');
			document.querySelector('.mv3-scroll-prev')?.addEventListener('click', () => foodScroll?.scrollBy({ left: -304, behavior: 'smooth' }));
			document.querySelector('.mv3-scroll-next')?.addEventListener('click', () => foodScroll?.scrollBy({ left: 304, behavior: 'smooth' }));
		</script>
	</body>
</html>

<style lang="scss" is:global>
	:root { --cream: #fbf9f4; --cream-low: #f5f3ee; --green: #506143; --green-soft: #687a5a; --gold: #967523; --ink: #1b1c19; --muted: #555a51; --line: #c5c8bd; }
	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	body { margin: 0; color: var(--ink); background: var(--cream); font-family: 'Manrope', sans-serif; line-height: 1.6; overflow-x: hidden; }
	a { color: inherit; text-decoration: none; }
	img { display: block; width: 100%; }
	button, input { font: inherit; }
	.container { width: min(100% - 128px, 1152px); margin-inline: auto; }
	.material-symbols-outlined { font-family: 'Material Symbols Outlined'; font-weight: normal; font-style: normal; font-size: 25px; line-height: 1; letter-spacing: normal; text-transform: none; white-space: nowrap; -webkit-font-feature-settings: 'liga'; -webkit-font-smoothing: antialiased; }
	.filled { font-variation-settings: 'FILL' 1; }
	.site-header { position: fixed; z-index: 50; top: 0; width: 100%; border-bottom: 1px solid rgba(80,97,67,.06); background: rgba(251,249,244,.86); backdrop-filter: blur(18px); }
	.nav-wrap { height: 78px; display: flex; align-items: center; gap: 38px; }
	.brand { color: var(--green); font: 500 27px/1 'Playfair Display', serif; letter-spacing: -.03em; white-space: nowrap; }
	.nav-wrap nav { display: flex; gap: 28px; margin-left: auto; }
	.nav-wrap nav a, .footer nav a { color: #494e46; font-size: 13px; }
	.nav-wrap nav .active { color: var(--green); font-weight: 700; border-bottom: 2px solid var(--green); }
	.button { display: inline-flex; align-items: center; justify-content: center; padding: 14px 29px; border: 1px solid var(--green); border-radius: 999px; color: white; background: var(--green); font-size: 12px; font-weight: 700; letter-spacing: .055em; text-transform: uppercase; transition: transform .2s, box-shadow .2s; }
	.button:hover { transform: translateY(-2px); box-shadow: 0 14px 30px rgba(80,97,67,.18); }
	.button-small { padding: 10px 22px; font-size: 12px; letter-spacing: 0; text-transform: none; }
	.button-outline { color: var(--green); background: transparent; }
	.hero { position: relative; min-height: 920px; display: flex; align-items: center; overflow: hidden; }
	.hero-bg { position: absolute; inset: 0; background: linear-gradient(90deg, var(--cream) 0%, rgba(251,249,244,.93) 35%, rgba(251,249,244,.28) 70%, transparent), url('/images/instituto-fc-v3/hero.jpg') center / cover; }
	.hero-content { position: relative; z-index: 2; }
	.hero-copy { max-width: 650px; }
	.tag { display: inline-block; margin-bottom: 23px; padding: 6px 13px; border-radius: 999px; color: #26351d; background: #d5e9c3; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	h1, h2, h3, blockquote { margin-top: 0; font-family: 'Playfair Display', serif; font-weight: 500; line-height: 1.15; }
	h1 { max-width: 620px; margin-bottom: 24px; font-size: clamp(55px, 5.3vw, 76px); letter-spacing: -.04em; }
	.hero-copy > p { max-width: 540px; margin: 0 0 34px; color: var(--muted); font-size: 18px; line-height: 1.75; }
	.actions { display: flex; gap: 14px; }
	.method-card { position: absolute; z-index: 3; right: max(64px, calc((100vw - 1152px)/2)); bottom: 85px; width: 310px; padding: 26px; border: 1px solid rgba(197,200,189,.4); border-radius: 8px; background: rgba(251,249,244,.72); box-shadow: 0 18px 50px rgba(80,97,67,.13); backdrop-filter: blur(14px); animation: float 4s ease-in-out infinite; }
	.method-card div { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
	.method-card .material-symbols-outlined { color: var(--gold); }
	.method-card strong { font-size: 12px; letter-spacing: .05em; text-transform: uppercase; }
	.method-card p { margin: 0; color: var(--muted); font-size: 13px; }
	.section { padding: 118px 0; }
	.section-heading { max-width: 700px; margin: 0 auto 68px; text-align: center; }
	.section-heading h2, .hydration-copy h2 { margin-bottom: 17px; font-size: clamp(40px, 4vw, 54px); letter-spacing: -.03em; }
	.section-heading p, .hydration-copy > p { margin: 0; color: var(--muted); font-size: 17px; }
	.food-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
	.food-card { transition-delay: .08s; }
	.food-image { aspect-ratio: 1; margin-bottom: 28px; overflow: hidden; border: 1px solid transparent; border-radius: 50%; background: #f0eee9; transition: border .3s; }
	.food-image img { height: 100%; object-fit: cover; transition: transform .6s; }
	.food-card:hover .food-image { border-color: #b9cda8; }
	.food-card:hover img { transform: scale(1.07); }
	.food-card h3 { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; font-size: 25px; }
	.food-card h3 span { color: var(--green); font-size: 22px; }
	.food-card p { margin: 0; color: var(--muted); font-size: 14px; }
	.hydration { background: var(--cream-low); }
	.hydration-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 84px; }
	.hydration-visual { position: relative; }
	.hydration-visual > img { aspect-ratio: 4 / 5; border-radius: 10px; object-fit: cover; box-shadow: 0 28px 55px rgba(45,55,39,.14); }
	.image-label { position: absolute; top: 28px; left: 28px; padding: 20px 24px; border: 1px solid rgba(255,255,255,.35); border-radius: 7px; background: rgba(251,249,244,.72); backdrop-filter: blur(12px); }
	.image-label span, .image-label small { display: block; color: var(--green); }
	.image-label span { margin-bottom: 6px; font-size: 38px; }
	.image-label small { font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
	.hydration-copy > p { margin-bottom: 26px; line-height: 1.75; }
	.hydration-copy ul { display: grid; gap: 14px; margin: 0 0 34px; padding: 0; list-style: none; }
	.hydration-copy li { display: flex; align-items: center; gap: 11px; font-size: 14px; }
	.hydration-copy li span { color: var(--gold); font-size: 22px; }
	.hydration-copy blockquote { margin: 0; padding: 20px 24px; border-left: 4px solid var(--green); border-radius: 0 5px 5px 0; color: var(--muted); background: rgba(104,122,90,.06); font-family: 'Manrope', sans-serif; font-size: 17px; font-style: italic; }
	.protocol-section { background: var(--cream); }
	.protocol { position: relative; overflow: hidden; padding: 76px; border-radius: 18px; color: white; background: var(--green); text-align: center; }
	.protocol::after { content: ''; position: absolute; inset: 0; background: radial-gradient(circle, rgba(255,255,255,.12), transparent 65%); pointer-events: none; }
	.protocol > * { position: relative; z-index: 1; }
	.protocol h2 { max-width: 750px; margin: 0 auto 20px; font-size: clamp(40px, 4vw, 55px); }
	.protocol > p { max-width: 620px; margin: 0 auto 36px; opacity: .87; }
	.protocol form { display: grid; grid-template-columns: 1fr 1fr auto; gap: 12px; max-width: 860px; margin: auto; }
	.protocol input { min-width: 0; padding: 15px 21px; border: 1px solid rgba(255,255,255,.24); border-radius: 999px; outline: 0; color: white; background: rgba(255,255,255,.09); }
	.protocol input::placeholder { color: rgba(255,255,255,.6); }
	.protocol button { padding: 15px 24px; border: 0; border-radius: 999px; color: white; background: #8b6b1c; font-size: 11px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; cursor: pointer; }
	.protocol small { display: block; margin-top: 22px; opacity: .65; }
	.footer { padding: 38px 0; border-top: 1px solid rgba(197,200,189,.4); background: var(--cream-low); }
	.footer-wrap { display: flex; align-items: center; justify-content: space-between; gap: 32px; }
	.footer-wrap > div:first-child small { display: block; margin-top: 8px; color: var(--muted); font-size: 10px; }
	.footer nav { display: flex; gap: 24px; }
	.footer-icons { display: flex; gap: 10px; }
	.footer-icons a { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid var(--line); border-radius: 50%; color: var(--green); }
	.footer-icons span { font-size: 19px; }
	.fab { position: fixed; z-index: 40; right: 28px; bottom: 28px; display: grid; place-items: center; width: 55px; height: 55px; border-radius: 50%; color: white; background: #8b6b1c; box-shadow: 0 10px 25px rgba(60,45,10,.25); }
	.fab > span:last-child { position: absolute; right: 66px; width: max-content; padding: 5px 10px; border-radius: 4px; color: white; background: var(--ink); font-family: 'Manrope', sans-serif; font-size: 10px; opacity: 0; transition: opacity .2s; }
	.fab:hover > span:last-child { opacity: 1; }
	.mobile-v3, .mobile-menu, .mobile-bottom-nav { display: none; }
	.reveal { opacity: 0; transform: translateY(20px); transition: opacity .75s, transform .75s; }
	.reveal.visible { opacity: 1; transform: none; }
	@keyframes float { 50% { transform: translateY(-10px); } }
	@media (max-width: 900px) {
		.container { width: min(100% - 48px, 740px); }
		.nav-wrap nav { display: none; }
		.hero { min-height: 820px; }
		.hero-bg { background: linear-gradient(90deg, rgba(251,249,244,.96), rgba(251,249,244,.52)), url('/images/instituto-fc-v3/hero.jpg') center / cover; }
		.method-card { display: none; }
		.food-grid { grid-template-columns: 1fr 1fr; gap: 46px 28px; }
		.hydration-grid { gap: 48px; }
		.protocol { padding: 58px 34px; }
		.protocol form { grid-template-columns: 1fr 1fr; }
		.protocol button { grid-column: span 2; }
		.footer-wrap { flex-wrap: wrap; }
	}
	@media (max-width: 620px) {
		body { padding-bottom: 67px; }
		.container { width: min(100% - 40px, 520px); }
		.desktop-v3, .nav-wrap .button-small, .fab { display: none; }
		.mobile-v3, .mobile-menu, .mobile-bottom-nav { display: block; }
		.nav-wrap { height: 68px; }
		.brand { font-size: 23px; }
		.mobile-menu { margin-left: auto; padding: 7px; border: 0; color: var(--green); background: transparent; }
		.mobile-menu span { font-size: 28px; }
		.mv3-shell { width: calc(100% - 40px); max-width: 520px; margin-inline: auto; }
		.mv3-hero { position: relative; min-height: 751px; display: flex; align-items: flex-end; overflow: hidden; padding: 0 0 48px; }
		.mv3-hero-bg { position: absolute; inset: 0; background: linear-gradient(0deg, var(--cream) 3%, rgba(251,249,244,.65) 40%, rgba(251,249,244,.02) 78%), url('/images/instituto-fc-v3/mobile-hero.webp') center / cover; }
		.mv3-hero-copy { position: relative; z-index: 1; }
		.mv3-hero-copy > span { display: block; margin-bottom: 12px; color: var(--green); font-size: 10px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
		.mv3-hero h1 { margin-bottom: 19px; color: var(--ink); font-size: 46px; line-height: 1.08; }
		.mv3-hero-copy > p { margin: 0 0 24px; color: var(--muted); font-size: 15px; line-height: 1.65; }
		.mv3-hero-copy > div { display: flex; align-items: center; gap: 14px; }
