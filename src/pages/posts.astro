---
import SectionLayout from "../layouts/sectionLayout.astro";
---

<SectionLayout
  title="Posts"
  eyebrow="Notas e aprendizados"
  description="Um espaço para registrar decisões técnicas, descobertas e ideias sobre desenvolvimento de software."
>
  <section class="empty-state">
    <div class="empty-state__mark" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <p>Em preparação</p>
    <h2>O primeiro texto ainda está sendo escrito.</h2>
    <div>
      Em breve, esta página terá posts sobre frontend, mobile, arquitetura e os
      aprendizados que aparecem no caminho.
    </div>
    <a href="/">Voltar para o início <span>↗</span></a>
  </section>
</SectionLayout>

<style lang="scss">
  .empty-state {
    min-height: 430px;
    padding: clamp(28px, 6vw, 64px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    border: 1px dashed #c9ccc5;
    border-radius: 30px;
    background: #eceee9;
  }

  .empty-state__mark {
    width: 74px;
    height: 74px;
    margin-bottom: 34px;
    padding: 17px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    border-radius: 22px;
    background: #171816;
    transform: rotate(-4deg);
  }

  .empty-state__mark span {
    height: 3px;
    border-radius: 999px;
    background: #83d8a2;
  }

  .empty-state__mark span:nth-child(2) { width: 72%; }

  .empty-state > p {
    margin: 0 0 10px;
    color: #258753;
    font-size: 0.72rem;
    font-weight: 780;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .empty-state h2 {
    max-width: 680px;
    margin: 0;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .empty-state > div:not(.empty-state__mark) {
    max-width: 620px;
    margin-top: 20px;
    color: #6b6f69;
    line-height: 1.6;
  }

  .empty-state a {
    margin-top: 32px;
    padding: 12px 16px;
    border-radius: 999px;
    background: #fff;
    color: #171816;
    font-size: 0.8rem;
    font-weight: 720;
    text-decoration: none;
  }
</style>
