  }

  .profile__links a:hover {
    transform: translateY(-2px);
    background: #fff;
    border-color: #aeb2ab;
  }

  .profile__links svg {
    width: 17px;
    height: 17px;
  }

  .profile__education {
    margin-top: auto;
    padding-top: 44px;
    display: grid;
    gap: 4px;
    font-size: 0.84rem;
  }

  .profile__education > span {
    color: #868a83;
  }

  .profile__education a {
    color: #696c68;
    text-decoration: none;
  }

  .bento {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .card,
  .project-card {
    position: relative;
    overflow: hidden;
    border: 1px solid #dedfdb;
    border-radius: 28px;
    background: #fff;
    color: #171816;
  }

  a.card,
  .project-card {
    text-decoration: none;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  a.card:hover,
  .project-card:hover {
    transform: translateY(-4px);
