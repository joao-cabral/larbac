    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: #171816;
    font-size: 1.15rem;
  }

  .section-heading h2,
  .card h2 {
    margin: 0;
    font-size: clamp(1.6rem, 2.3vw, 2.35rem);
    line-height: 1.04;
    letter-spacing: -0.055em;
  }

  .card--skills {
    grid-column: 1 / -1;
    padding: 0;
    background: #f8faf8;
    border-color: #d5d9d5;
  }

  .contributions {
    min-height: 330px;
    position: relative;
    z-index: 1;
    padding: clamp(22px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
