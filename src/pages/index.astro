---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/index.astro";
import { DotPattern } from "../components/ui/dot-pattern";

const projects = [
  {
    title: "Clickmax",
    description: "Plataforma all-in-one para negócios digitais.",
    href: "/projects/clickmax-project",
    image: "https://media1.giphy.com/media/3oKIPEqDGUULpEU0aQ/200w.webp",
    tags: ["React", "TypeScript", "Fastify"],
    className: "project-card--blue",
  },
  {
    title: "Sistema de Rotas",
    description: "Acompanhamento de rotas e geolocalização em tempo real.",
    href: "/projects/routes-project",
    image: "https://media4.giphy.com/media/j1RdWetLBJQIdP8TnK/200w.webp",
    tags: ["GetX", "MapBox", "SocketIO"],
    className: "project-card--coral",
  },
  {
    title: "Sensoriamento IoT",
    description: "Configuração e monitoramento de placas IoT via MQTT.",
    href: "/projects/nimrod-project",
    image: "https://media2.giphy.com/media/LNmzbkBXpDl5yPGtf2/200w.webp",
    tags: ["Flutter", "Angular", "MQTT"],
    className: "project-card--dark",
  },
];

const contributionYear = new Date().getFullYear();
const calendarStart = new Date(Date.UTC(contributionYear, 0, 1));
calendarStart.setUTCDate(calendarStart.getUTCDate() - calendarStart.getUTCDay());

const contributionCells = Array.from({ length: 371 }, (_, index) => {
  const date = new Date(calendarStart);
  date.setUTCDate(calendarStart.getUTCDate() + index);
  const column = Math.floor(index / 7);
  const value = (index * 17 + Math.floor(index / 7) * 11) % 13;
  const level = column > 29 ? 0 : value < 6 ? 0 : value < 9 ? 1 : value < 11 ? 2 : value === 11 ? 3 : 4;

  return {
    date: date.toISOString().slice(0, 10),
    level,
  };
});

const primaryTechnologies = [
  { name: "React", symbol: "⚛", color: "#61dafb" },
  { name: "TypeScript", symbol: "TS", color: "#5aa6f8" },
  { name: "Flutter", symbol: "◆", color: "#68c8ff" },
  { name: "Angular", symbol: "A", color: "#f45b69" },
  { name: "Node.js", symbol: "JS", color: "#81c784" },
  { name: "PostgreSQL", symbol: "DB", color: "#8ab4e8" },
];

const experiences = [
  {
    company: "Bilhon",
    role: "Engenheiro de Software",
    period: "2024 — agora",
    description:
      "Desenvolvimento frontend de uma plataforma completa de marketing digital em arquitetura de monorepo.",
    current: true,
  },
  {
    company: "Kasco P&D",
    role: "Engenheiro de Software",
    period: "2022 — 2024",
    description:
      "Liderança técnica e desenvolvimento de soluções web, desktop e mobile para o setor agro.",
  },
  {
    company: "Grupo ICTS",
    role: "Engenheiro de Software",
    period: "2021 — 2023",
    description:
      "Produtos web e mobile para sensoriamento IoT e acompanhamento de rotas em tempo real.",
  },
  {
    company: "Sidia",
    role: "Desenvolvedor de Testes",
    period: "2019 — 2021",
    description:
      "Automação de testes e ferramentas internas para os principais dispositivos Samsung.",
  },
];
---

<Layout title="João Cabral — Software Engineer" header={true}>
  <div class="page-background" aria-hidden="true">
    <DotPattern className="dot-pattern" width={24} height={24} cx={1.5} cy={1.5} cr={1.1} />
  </div>
  <div class="portfolio-shell">
    <aside class="profile">
      <div class="profile__portrait-wrap">
        <img
          class="profile__portrait"
          src="/images/joao-cabral.png"
          alt="Retrato de João Cabral"
          width="256"
          height="256"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
      </div>

      <div class="profile__copy">
        <p class="eyebrow">Software engineer · Manaus, BR</p>
        <h1>
          João Ca<span id="location-slot" class="location-slot"><span id="location-static" class="location-static"><span class="letter-yellow">B</span><span class="letter-green">R</span></span><span
              id="location-slider"
              class="location-code"
              aria-hidden="true"
              hidden
            ><span class="location-code__item location-code__item--mao">MAO</span></span></span><span class="location-suffix">al</span>
        </h1>
        <p class="profile__intro">
          Engenheiro de Software Fullstack/Mobile com mais de 7 anos construindo
          produtos web, mobile e desktop. Uno arquitetura, performance e visão de
          produto para entregar soluções escaláveis, da concepção à produção.
        </p>
      </div>

      <nav class="profile__links" aria-label="Links profissionais">
        <a href="./curriculum-pt">
          <Icon name="mdi:file-download" />
          Currículo
        </a>
        <a href="https://www.linkedin.com/in/jo%C3%A3o-cabral-6296a8174/" target="_blank" rel="noreferrer">
          <Icon name="mdi:linkedin" />
          LinkedIn
        </a>
        <a href="https://github.com/joao-cabral" target="_blank" rel="noreferrer">
          <Icon name="mdi:github" />
          GitHub
        </a>
      </nav>

      <div class="profile__education">
        <span>Formação</span>
        <strong>Sistemas de Informação</strong>
        <a href="https://fucapi.edu.br/" target="_blank" rel="noreferrer">FUCAPI · 2017—2020</a>
      </div>
    </aside>

    <main class="bento" aria-label="Portfólio">
      <section class="card card--skills">
        <a
          class="contributions"
          href="https://github.com/joao-cabral"
          target="_blank"
          rel="noreferrer"
        >
          <div class="contributions__header">
            <Icon name="mdi:github" />
            <div>
              <strong>Contribuições no GitHub</strong>
              <span id="contributions-status">@joao-cabral · carregando atividade</span>
            </div>
          </div>
          <div class="contributions__calendar" aria-hidden="true">
            <div class="contributions__months">
              <span>Jan</span><span>Fev</span><span>Mar</span><span>Abr</span>
              <span>Mai</span><span>Jun</span><span>Jul</span><span>Ago</span>
              <span>Set</span><span>Out</span><span>Nov</span><span>Dez</span>
            </div>
            <div class="contributions__body">
              <div class="contributions__weekdays">
                <span>Dom</span><span>Seg</span><span>Ter</span><span>Qua</span>
                <span>Qui</span><span>Sex</span><span>Sáb</span>
              </div>
              <div class="contributions__grid">
                {contributionCells.map((cell, index) => (
                  <span
                    class={`level-${cell.level}`}
                    data-contribution-date={cell.date}
                    style={`--delay: ${(Math.floor(index / 7) * 35) + ((index % 7) * 55)}ms`}
                  ></span>
                ))}
              </div>
            </div>
          </div>
          <div class="contributions__footer">
            <span>Ver atividade no GitHub ↗</span>
            <div class="contributions__legend" aria-hidden="true">
              <span>Menos</span>
              <i class="level-0"></i><i class="level-1"></i><i class="level-2"></i>
              <i class="level-3"></i><i class="level-4"></i>
              <span>Mais</span>
            </div>
          </div>
        </a>

        <div class="technology-strip">
          <div>
            <p class="eyebrow">Principais tecnologias</p>
            <h2>Ferramentas que uso para construir</h2>
          </div>
          <div class="technology-icons">
            {primaryTechnologies.map((technology) => (
              <div class="technology-icon" style={`--icon-color: ${technology.color}`}>
                <strong class="technology-icon__mark">{technology.symbol}</strong>
                <span>{technology.name}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <a
        class="card card--clickmax"
        href="https://clickmax.io/"
        target="_blank"
        rel="noreferrer"
      >
        <span class="card__arrow" aria-hidden="true">↗</span>
        <div class="clickmax__header">
          <span class="clickmax__mark">clickmax</span>
          <span>Clickmax 2.0</span>
        </div>
        <div class="clickmax__copy">
          <p>Marketing · SaaS</p>
          <h2>Clickmax</h2>
          <p>Uma plataforma completa para criar, vender e escalar negócios digitais.</p>
        </div>
        <video
          class="clickmax__image"
          src="/videos/funnel-builder.webm"
          aria-label="Demonstração do construtor de funis do Clickmax"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
        ></video>
      </a>

      <section class="card card--connect">
        <div class="connect__header">
          <div class="connect__icon"><Icon name="mdi:github" /></div>
          <a href="https://github.com/joao-cabral" target="_blank" rel="noreferrer">
            Seguir <span>↗</span>
          </a>
        </div>
        <div>
          <p class="eyebrow">Open source</p>
          <h2>GitHub</h2>
          <p class="connect__handle">@joao-cabral</p>
        </div>
        <div class="code-grid" aria-hidden="true">
          <span>TS</span><span>FL</span><span>RE</span><span>JS</span><span>NG</span><span>DB</span>
        </div>
      </section>

      <section class="projects-section">
        <div class="section-heading projects-section__heading">
          <p class="eyebrow">Projetos selecionados</p>
          <h2>Projetos em que trabalhei</h2>
        </div>
        <div class="projects-grid">
          {projects.map((project) => (
            <a href={project.href} class={`project-card ${project.className}`}>
              <span class="card__arrow" aria-hidden="true">↗</span>
              <img src={project.image} alt="" loading="lazy" />
              <div class="project-card__body">
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <div class="tags">
                  {project.tags.map((tag) => <span>{tag}</span>)}
                </div>
              </div>
            </a>
          ))}
          <a href="/games/schulte-table" class="project-card project-card--game">
            <span class="card__arrow" aria-hidden="true">↗</span>
            <div class="game-mark" aria-hidden="true">25</div>
            <div class="project-card__body">
              <p class="eyebrow">Experimento</p>
              <h3>Tabela de Schulte</h3>
              <p>Um jogo de concentração e velocidade mental.</p>
              <div class="tags"><span>JavaScript</span><span>CSS Grid</span></div>
            </div>
          </a>
        </div>
      </section>

      <section class="card card--experience">
        <div class="section-heading experience__heading">
          <p class="eyebrow">Trajetória</p>
          <h2>Experiência</h2>
        </div>
        <div class="timeline">
          {experiences.map((experience) => (
            <article class:list={["timeline__item", { "is-current": experience.current }]}>
              <div class="timeline__period">{experience.period}</div>
              <div>
                <div class="timeline__title">
                  <h3>{experience.company}</h3>
                  <span>{experience.role}</span>
                </div>
                <p>{experience.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>
  </div>
</Layout>

<script>
  const staticLocation = document.querySelector<HTMLElement>("#location-static");
  const locationSlot = document.querySelector<HTMLElement>("#location-slot");
  const locationSlider = document.querySelector<HTMLElement>("#location-slider");
  const locationItem = locationSlider?.querySelector<HTMLElement>(".location-code__item");

  if (
    staticLocation &&
    locationSlot &&
    locationSlider &&
    locationItem &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    locationItem.addEventListener("animationend", () => {
      locationSlider.hidden = true;
      locationSlot.classList.remove("is-sliding");
    }, { once: true });

    window.setTimeout(() => {
      locationSlot.classList.add("is-sliding");
      locationSlider.hidden = false;
    }, 700);
  }

  const status = document.querySelector("#contributions-status");
  const cells = new Map(
    Array.from(document.querySelectorAll<HTMLElement>("[data-contribution-date]")).map(
      (cell) => [cell.dataset.contributionDate, cell],
    ),
  );

  const year = new Date().getFullYear();

  fetch(`https://github-contributions-api.jogruber.de/v4/joao-cabral?y=${year}`)
    .then((response) => {
      if (!response.ok) throw new Error("Não foi possível carregar as contribuições");
      return response.json();
    })
    .then((data) => {
      for (const contribution of data.contributions ?? []) {
        const cell = cells.get(contribution.date);
        if (!cell) continue;

        cell.className = `level-${contribution.level}`;
        cell.title = `${contribution.count} contribuições em ${contribution.date}`;
      }

      if (status) status.textContent = `@joao-cabral · atualizado agora`;
    })
    .catch(() => {
      if (status) status.textContent = "@joao-cabral · atividade indisponível";
    });
</script>

<style lang="scss">
  :global(body) {
    margin: 0;
    background: transparent;
    color: #171816;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  :global(html) {
    background: #fff;
  }

  .page-background {
    position: fixed;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  :global(.dot-pattern) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: #d2d6cf;
    opacity: 0.62;
  }

  :global(.site-header) {
    background: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  :global(.site-header nav[aria-label="Navegação principal"]) {
    height: auto;
    padding: 4px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(.portfolio-shell *) {
    font-family: inherit;
  }

  :global(.footer) {
    color: #686b66;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-weight: 500;
  }

  .portfolio-shell {
    --layout-gap: clamp(32px, 5vw, 88px);
    --page-padding: clamp(24px, 4vw, 72px);
    width: min(1580px, 100%);
    margin: 0 auto;
    padding: var(--page-padding);
    padding-top: 0;
    display: grid;
    grid-template-columns: minmax(330px, 0.78fr) minmax(0, 1.55fr);
    gap: var(--layout-gap);
    align-items: start;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .profile {
    position: fixed;
    top: var(--site-header-height);
    width: max(
      330px,
      calc(
        (min(1580px, 100vw) - (2 * var(--page-padding)) - var(--layout-gap)) *
          0.33476
      )
    );
    height: calc(100vh - var(--site-header-height) - var(--page-padding));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .profile__portrait-wrap {
    position: relative;
    margin-bottom: clamp(24px, 5vw, 12px);
  }

  .profile__portrait {
    width: clamp(176px, 16vw, 248px);
    aspect-ratio: 1;
    display: block;
    object-fit: cover;
    border-radius: 50%;
    box-shadow: 0 18px 50px rgba(25, 31, 27, 0.12);
  }

  .profile__status {
    position: absolute;
    right: 9%;
    bottom: 7%;
    width: 22px;
    height: 22px;
    border: 5px solid #f4f5f2;
    border-radius: 50%;
    background: #31aa65;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: #6d716b;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .profile h1 {
    margin: 0;
    font-size: clamp(2.55rem, 4.1vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.075em;
    font-weight: 780;
  }

  .location-slot {
    position: relative;
    display: inline-block;
  }

  .location-static {
    transition: opacity 180ms ease;
  }

  .location-slot.is-sliding .location-static {
    opacity: 0;
  }

  .location-suffix {
    display: inline-block;
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .location-slot.is-sliding + .location-suffix {
    transform: translateX(0.62em);
  }

  .location-code {
    position: absolute;
    top: 1;
    left: 0;
    width: 1.62em;
    height: 0.92em;
    overflow: hidden;
    white-space: nowrap;
  }

  .location-code[hidden] {
    display: none;
  }

  .location-code__item {
    display: inline-block;
    font-family: "BrasilComS", sans-serif;
    font-size: 1.18em;
    line-height: 1;
    animation: location-code-slide 1.8s ease-in-out forwards;
  }

  .letter-yellow,
  .letter-green {
    display: inline-block;
    font-family: "BrasilComS", sans-serif;
    font-size: 1.18em;
    line-height: 1;
    vertical-align: -0.10em;
  }

  .letter-yellow {
    color: #e6b92f;
  }

  .letter-green {
    color: #31aa65;
  }

  .location-code__item--mao {
    color: #2563a8;
    background: linear-gradient(90deg, #2563a8 0%, #2563a8 32%, #f7f7f4 33%, #f7f7f4 65%, #d6343d 66%, #d6343d 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 1px 0 rgba(23, 24, 22, 0.18));
  }

  @keyframes location-code-slide {
    0% { opacity: 0; transform: translateY(-110%); }
    18%, 72% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(110%); }
  }

  .verified {
    display: inline-grid;
    place-items: center;
    margin-left: 12px;
    width: 0.48em;
    height: 0.48em;
    vertical-align: 0.4em;
    border-radius: 50%;
    background: #278ee9;
    color: white;
    font-size: 0.32em;
    letter-spacing: 0;
  }

  .profile__intro {
    max-width: 570px;
    margin: 24px 0 0;
    color: #696c68;
    font-size: clamp(1.08rem, 1.45vw, 1.5rem);
    line-height: 1.55;
    letter-spacing: -0.025em;
  }

  .profile__links {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .profile__links a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 13px;
    border: 1px solid #d8dad5;
    border-radius: 999px;
    color: #30322f;
    background: rgba(255, 255, 255, 0.55);
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
