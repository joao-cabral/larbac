---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/index.astro";
import { DotPattern } from "../components/ui/dot-pattern";
import ProfessionalProjectCard from "../components/ProfessionalProjectCard.astro";
import { professionalProjects } from "../lib/professional-projects";
import PersonalProjectCards from "../components/PersonalProjectCards.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import ExternalIcon from "../components/ExternalIcon.astro";

const projects = professionalProjects.filter((project) => project.featured);

const contributionYear = new Date().getFullYear();
const calendarStart = new Date(Date.UTC(contributionYear, 0, 1));
calendarStart.setUTCDate(calendarStart.getUTCDate() - calendarStart.getUTCDay());

const contributionCells = Array.from({ length: 371 }, (_, index) => {
  const date = new Date(calendarStart);
  date.setUTCDate(calendarStart.getUTCDate() + index);
  const column = Math.floor(index / 7);
  const value = (index * 17 + Math.floor(index / 7) * 11) % 13;
  const level = column > 29 ? 0 : value < 6 ? 0 : value < 9 ? 1 : value < 11 ? 2 : value === 11 ? 3 : 4;

  return {
    date: date.toISOString().slice(0, 10),
    level,
  };
});
---

<Layout title="João Cabral — Software Engineer" header={true}>
  <div class="page-background" aria-hidden="true">
    <DotPattern className="dot-pattern" width={24} height={24} cx={1.5} cy={1.5} cr={1.1} />
  </div>
  <div class="portfolio-shell">
    <aside class="profile">
      <div class="profile__portrait-wrap">
        <img
          class="profile__portrait"
          src="/images/joao-cabral.png"
          alt="Retrato de João Cabral"
          width="256"
          height="256"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
      </div>

      <div class="profile__copy">
        <p class="eyebrow">Software engineer · Manaus, BR</p>
        <h1>
          João Ca<span id="location-slot" class="location-slot"><span id="location-static" class="location-static"><span class="letter-yellow">B</span><span class="letter-green">R</span></span><span
              id="location-slider"
              class="location-code"
              aria-hidden="true"
              hidden
            ><span class="location-code__item location-code__item--mao">MAO</span></span></span><span class="location-suffix">al</span>
        </h1>
        <p class="profile__intro">
          Engenheiro de Software Fullstack/Mobile com mais de 7 anos construindo
          produtos web, mobile e desktop. Uno arquitetura, performance e visão de
          produto para entregar soluções escaláveis, da concepção à produção.
        </p>
      </div>

      <nav class="profile__links" aria-label="Links profissionais">
        <a href="./curriculum-pt">
          <Icon name="mdi:file-download" />
          Currículo
        </a>
        <a href="https://www.linkedin.com/in/jo%C3%A3o-cabral-6296a8174/" target="_blank" rel="noreferrer">
          <Icon name="mdi:linkedin" />
          LinkedIn
        </a>
        <a href="https://github.com/joao-cabral" target="_blank" rel="noreferrer">
          <Icon name="mdi:github" />
          GitHub
        </a>
      </nav>
    </aside>

    <main class="bento" aria-label="Portfólio">
      <section class="card card--skills">
        <a
          class="contributions"
          href="https://github.com/joao-cabral"
          target="_blank"
          rel="noreferrer"
        >
          <div class="contributions__header">
            <Icon name="mdi:github" />
            <div>
              <strong>Contribuições no GitHub</strong>
              <span id="contributions-status">@joao-cabral · carregando atividade</span>
            </div>
          </div>
          <div class="contributions__calendar" aria-hidden="true">
            <div class="contributions__months">
              <span>Jan</span><span>Fev</span><span>Mar</span><span>Abr</span>
              <span>Mai</span><span>Jun</span><span>Jul</span><span>Ago</span>
              <span>Set</span><span>Out</span><span>Nov</span><span>Dez</span>
            </div>
            <div class="contributions__body">
              <div class="contributions__weekdays">
                <span>Dom</span><span>Seg</span><span>Ter</span><span>Qua</span>
                <span>Qui</span><span>Sex</span><span>Sáb</span>
              </div>
              <div class="contributions__grid">
                {contributionCells.map((cell, index) => (
                  <span
                    class={`level-${cell.level}`}
                    data-contribution-date={cell.date}
                    style={`--delay: ${(Math.floor(index / 7) * 35) + ((index % 7) * 55)}ms`}
                  ></span>
                ))}
              </div>
            </div>
          </div>
          <div class="contributions__footer">
            <span>Ver atividade no GitHub<ExternalIcon /></span>
            <div class="contributions__legend" aria-hidden="true">
              <span>Menos</span>
              <i class="level-0"></i><i class="level-1"></i><i class="level-2"></i>
              <i class="level-3"></i><i class="level-4"></i>
              <span>Mais</span>
            </div>
          </div>
        </a>
      </section>


      <section class="projects-section">
        <div class="section-heading projects-section__heading">
          <div>
            <h2>Projetos</h2>
          </div>
        </div>
        <div class="projects-grid professional-grid">
          {projects.map((project) => (
            <ProfessionalProjectCard project={project} />
          ))}
          <PersonalProjectCards limit={1} wide={true} />
        </div>
        <a class="projects-section__more" href="/trabalhos">Ver mais</a>
      </section>

      <ExperienceTimeline />
    </main>
  </div>
</Layout>

<script>
  const staticLocation = document.querySelector<HTMLElement>("#location-static");
  const locationSlot = document.querySelector<HTMLElement>("#location-slot");
  const locationSlider = document.querySelector<HTMLElement>("#location-slider");
  const locationItem = locationSlider?.querySelector<HTMLElement>(".location-code__item");

  if (
    staticLocation &&
    locationSlot &&
    locationSlider &&
    locationItem &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    locationItem.addEventListener("animationend", () => {
      locationSlider.hidden = true;
      locationSlot.classList.remove("is-sliding");
    }, { once: true });

    window.setTimeout(() => {
      locationSlot.classList.add("is-sliding");
      locationSlider.hidden = false;
    }, 700);
  }

  const status = document.querySelector("#contributions-status");
  const cells = new Map(
    Array.from(document.querySelectorAll<HTMLElement>("[data-contribution-date]")).map(
      (cell) => [cell.dataset.contributionDate, cell],
    ),
  );

  const year = new Date().getFullYear();

  fetch(`https://github-contributions-api.jogruber.de/v4/joao-cabral?y=${year}`)
    .then((response) => {
      if (!response.ok) throw new Error("Não foi possível carregar as contribuições");
      return response.json();
    })
    .then((data) => {
      for (const contribution of data.contributions ?? []) {
        const cell = cells.get(contribution.date);
        if (!cell) continue;

        cell.className = `level-${contribution.level}`;
        cell.title = `${contribution.count} contribuições em ${contribution.date}`;
      }

      if (status) status.textContent = `@joao-cabral · atualizado agora`;
    })
    .catch(() => {
      if (status) status.textContent = "@joao-cabral · atividade indisponível";
    });
</script>

<style lang="scss">
  .professional-grid { container-type: inline-size; }
  :global(body) {
    margin: 0;
    background: transparent;
    color: #171816;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  :global(html) {
    background: #fff;
  }

  .page-background {
    position: fixed;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  :global(.dot-pattern) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: #d2d6cf;
    opacity: 0.62;
  }

  :global(.site-header) {
    background: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  :global(.site-header nav[aria-label="Navegação principal"]) {
    height: auto;
    padding: 4px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(.portfolio-shell *) {
    font-family: inherit;
  }

  :global(.footer) {
    color: #686b66;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-weight: 500;
  }

  .portfolio-shell {
    --layout-gap: clamp(32px, 5vw, 88px);
    --page-padding: clamp(24px, 4vw, 72px);
    width: min(1580px, 100%);
    margin: 0 auto;
    padding: var(--page-padding);
    padding-top: 0;
    display: grid;
    grid-template-columns: minmax(330px, 0.78fr) minmax(0, 1.55fr);
    gap: var(--layout-gap);
    align-items: start;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .profile {
    position: fixed;
    top: var(--site-header-height);
    width: max(
      330px,
      calc(
        (min(1580px, 100vw) - (2 * var(--page-padding)) - var(--layout-gap)) *
          0.33476
      )
    );
    height: calc(100vh - var(--site-header-height) - var(--page-padding));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .profile__portrait-wrap {
    position: relative;
    margin-bottom: clamp(24px, 5vw, 12px);
  }

  .profile__portrait {
    width: clamp(176px, 16vw, 248px);
    aspect-ratio: 1;
    display: block;
    object-fit: cover;
    border-radius: 50%;
    box-shadow: 0 18px 50px rgba(25, 31, 27, 0.12);
  }

  .profile__status {
    position: absolute;
    right: 9%;
    bottom: 7%;
    width: 22px;
    height: 22px;
    border: 5px solid #f4f5f2;
    border-radius: 50%;
    background: #31aa65;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: #6d716b;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .profile h1 {
    margin: 0;
    font-size: clamp(2.55rem, 4.1vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.075em;
    font-weight: 780;
  }

  .location-slot {
    position: relative;
    display: inline-block;
  }

  .location-static {
    transition: opacity 180ms ease;
  }

  .location-slot.is-sliding .location-static {
    opacity: 0;
  }

  .location-suffix {
    display: inline-block;
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .location-slot.is-sliding + .location-suffix {
    transform: translateX(0.62em);
  }

  .location-code {
    position: absolute;
    top: 1;
    left: 0;
    width: 1.62em;
    height: 0.92em;
    overflow: hidden;
    white-space: nowrap;
  }

  .location-code[hidden] {
    display: none;
  }

  .location-code__item {
    display: inline-block;
    font-family: "BrasilComS", sans-serif;
    font-size: 1.18em;
    line-height: 1;
    animation: location-code-slide 1.8s ease-in-out forwards;
  }

  .letter-yellow,
  .letter-green {
    display: inline-block;
    font-family: "BrasilComS", sans-serif;
    font-size: 1.18em;
    line-height: 1;
    vertical-align: -0.10em;
  }

  .letter-yellow {
    color: #e6b92f;
  }

  .letter-green {
    color: #31aa65;
  }

  .location-code__item--mao {
    color: #2563a8;
    background: linear-gradient(90deg, #2563a8 0%, #2563a8 32%, #f7f7f4 33%, #f7f7f4 65%, #d6343d 66%, #d6343d 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 1px 0 rgba(23, 24, 22, 0.18));
  }

  @keyframes location-code-slide {
    0% { opacity: 0; transform: translateY(-110%); }
    18%, 72% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(110%); }
  }

  .verified {
    display: inline-grid;
    place-items: center;
    margin-left: 12px;
    width: 0.48em;
    height: 0.48em;
    vertical-align: 0.4em;
    border-radius: 50%;
    background: #278ee9;
    color: white;
    font-size: 0.32em;
    letter-spacing: 0;
  }

  .profile__intro {
    max-width: 570px;
    margin: 12px 0 0;
    color: #696c68;
    font-size: clamp(1.08rem, 1.45vw, 1.5rem);
    line-height: 1.55;
    letter-spacing: -0.025em;
  }

  .profile__links {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .profile__links a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 13px;
    border: 1px solid #d8dad5;
    border-radius: 999px;
    color: #30322f;
    background: rgba(255, 255, 255, 0.55);
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
    transition: 180ms ease;
  }

  .profile__links a:hover {
    transform: translateY(-2px);
    background: #fff;
    border-color: #aeb2ab;
  }

  .profile__links svg {
    width: 17px;
    height: 17px;
  }

  .bento {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px 24px;
  }

  .card,
  .project-card {
    position: relative;
    overflow: hidden;
    border: 1px solid #dedfdb;
    border-radius: 28px;
    background: #fff;
    color: #171816;
  }

  a.card,
  .project-card {
    text-decoration: none;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  a.card:hover,
  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 48px rgba(37, 41, 36, 0.11);
  }

  .card__arrow {
    position: absolute;
    z-index: 2;
    top: 18px;
    right: 18px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: #171816;
    font-size: 1.15rem;
  }

  .section-heading h2,
  .card h2 {
    margin: 0;
    font-size: clamp(1.6rem, 2.3vw, 2.35rem);
    line-height: 1.04;
    letter-spacing: -0.055em;
  }


  .card--skills {
    grid-column: 1 / -1;
    padding: 0;
    background: #f8faf8;
    border-color: #d5d9d5;
  }

  .contributions {
    min-height: 330px;
    position: relative;
    z-index: 1;
    padding: clamp(22px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 20px;
    background: #101311;
    color: #f5f7f5;
    text-decoration: none;
  }

  .contributions__header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .contributions__header svg {
    width: 34px;
    height: 34px;
  }

  .contributions__header div {
    display: grid;
    gap: 2px;
  }

  .contributions__header strong {
    font-size: 0.9rem;
  }

  .contributions__header span {
    color: #8d938f;
    font-size: 0.72rem;
  }

  .contributions__calendar {
    width: 100%;
    margin: 28px 0 20px;
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: #343a36 transparent;
  }

  .contributions__months,
  .contributions__body {
    min-width: 760px;
  }

  .contributions__months {
    padding-left: 46px;
    margin-bottom: 9px;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    color: #d6dad7;
    font-size: 0.68rem;
  }

  .contributions__body {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 8px;
  }

  .contributions__weekdays {
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    color: #c6cbc7;
    font-size: 0.62rem;
  }

  .contributions__grid {
    width: 100%;
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 3px;
  }

  .contributions__grid span {
    aspect-ratio: 1;
    border-radius: 2px;
    background: #202521;
  }

  .contributions__grid .level-1,
  .contributions__legend .level-1 { background: #173d24; }
  .contributions__grid .level-2,
  .contributions__legend .level-2 { background: #1d6b36; }
  .contributions__grid .level-3,
  .contributions__legend .level-3 { background: #2cad55; }
  .contributions__grid .level-4,
  .contributions__legend .level-4 { background: #64dc7d; }

  .contributions__grid span:not(.level-0) {
    animation: contribution-wave 3.6s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .contributions__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: #a8aea9;
    font-size: 0.72rem;
    font-weight: 680;
  }

  .contributions__legend {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .contributions__legend i {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    background: #202521;
  }


  @keyframes contribution-wave {
    0%, 70%, 100% { filter: brightness(1); transform: scale(1); }
    78% { filter: brightness(1.65); transform: scale(1.13); }
  }


  .projects-section {
    grid-column: 1 / -1;
  }

  .projects-section__heading {
    margin-bottom: 24px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }

  .projects-section__more {
    display: block;
    width: fit-content;
    margin: 6px 0 0 auto;
    color: #30332f;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color 180ms ease;
  }

  .projects-section__more:hover {
    color: #36764f;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }


  @media (max-width: 999px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  .project-card {
    min-height: 330px;
    display: flex;
    flex-direction: column;
    border: 0;
  }

  .project-card > img {
    width: 100%;
    height: 190px;
    object-fit: cover;
  }

  .project-card__body {
    margin-top: auto;
    padding: 24px;
  }

  .project-card h3 {
    margin: 0;
    font-size: 1.45rem;
    letter-spacing: -0.04em;
  }

  .project-card p {
    margin: 8px 0 18px;
    color: rgba(20, 24, 24, 0.68);
    font-size: 0.88rem;
    line-height: 1.5;
  }





  @media (max-width: 1080px) {
    .portfolio-shell {
      --layout-gap: 40px;
      grid-template-columns: minmax(280px, 0.65fr) minmax(0, 1.35fr);
    }

    .profile {
      width: max(
        280px,
        calc(
          (100vw - (2 * var(--page-padding)) - var(--layout-gap)) * 0.325
        )
      );
    }

    .bento {
      grid-template-columns: 1fr;
    }

    .card--skills,
    .projects-section {
      grid-column: 1;
    }


  }

  @media (max-width: 760px) {
    .portfolio-shell {
      display: block;
      padding: 24px 16px 48px;
    }

    .profile {
      position: static;
      width: auto;
      height: auto;
      min-height: 0;
      padding: 12px 8px 56px;
    }

    .profile__portrait-wrap {
      width: 100%;
      margin-bottom: 34px;
      display: flex;
      justify-content: center;
    }

    .profile__portrait {
      width: min(52vw, 190px);
      height: auto;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      object-position: center;
    }

    .profile h1 {
      font-size: clamp(2.7rem, 14vw, 4.4rem);
    }

    .profile__intro {
      font-size: 1.08rem;
    }

    .bento {
      grid-column: auto;
      gap: 56px 16px;
    }

    .card--skills {
      grid-template-columns: 1fr;
    }

    .contributions {
      min-height: 340px;
    }

    .contributions__footer {
      align-items: flex-start;
      flex-direction: column;
    }


    .card,
    .project-card {
      border-radius: 22px;
    }



    .projects-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }


  }

  @media (prefers-reduced-motion: reduce) {
    a.card,
    .project-card,
    .profile__links a {
      transition: none;
    }

    .contributions__grid span:not(.level-0) {
      animation: none;
    }


    .location-static,
    .location-suffix {
      transition: none;
    }

  }
</style>
