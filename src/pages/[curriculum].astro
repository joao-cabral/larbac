---
import { Icon } from 'astro-icon/components';
import { getCollection } from "astro:content";
import Layout from '../layouts/index.astro';

export async function getStaticPaths() {
  const cvs = await getCollection('curriculum'); 
  return cvs.map((cv) => ({
    params: { curriculum: cv.data.id },
    props: {
      ...cv
    }
  }));
}

const cv = Astro.props;
---

<Layout title={`${cv.data.name} | ${cv.data.title}`} header={false}>
  <div class='layout'>
    <nav>
      <div class='icon'>
        <a href='/' title='Voltar ao portfólio' aria-label='Voltar ao portfólio'>
          <Icon name='mdi:arrow-left' />
        </a>
      </div>

      <div class='langs'>
        Currículo
      </div>

      <div class='icon'>
        <a href={`/${cv.data.id}.pdf`} title='Baixar currículo em PDF' aria-label='Baixar currículo em PDF'>
          <Icon name='mdi:file-download' color='green' />
        </a>
      </div>
    </nav>

    <header>
        <h1>
          <br />
          {cv.data.name}
        </h1>
        <div class='role'>{cv.data.title}</div>
        <div class='updated'>{cv.data.month}</div>

      <div class='contact'>
        <a href={`tel:${cv.data.phone.replaceAll(' ', '')}`}>{cv.data.phone}</a>
        <span aria-hidden='true'> · </span>
        <a href={`mailto:${cv.data.email}`}>{cv.data.email}</a>
        <span aria-hidden='true'> · </span>
        <a href='https://larbac.me'>larbac.me</a>
        <span aria-hidden='true'> · </span>
        <a href='https://www.linkedin.com/in/jo%C3%A3o-cabral-6296a8174/'>linkedin.com/in/joão-cabral</a>
        <span aria-hidden='true'> · </span>
        <a href='https://github.com/joao-cabral'>github.com/joao-cabral</a>
      </div>
      <hr />
    </header>

    <div class='about'>
      <h2 class='layout-title'>Resumo Profissional</h2>
      {cv.data.about.map((a) => <p set:html={a} />)}
    </div>

    <div class='experience'>
      <div class='layout-title'>
        {cv.data.experienceName}
      </div>

      <ul>
        {
          cv.data.experiences.map((experience) => (
            <li>
              <div class='experience__about'>
                <div class='experience__heading'>
                  <h3>{experience.title}</h3>
                  <div class='experience__dates'>{experience.start} – {experience.end}</div>
                </div>
                {experience.type && <div class='experience__type'>{experience.type}</div>}

                {experience.about.map((c) => (
                  <p set:html={c} />
                ))}
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class='about'>
      <h4 class='layout-title'>
        {cv.data.ossTitle}
      </h4>

      {cv.data.oss.map((c) => <p set:html={c} />)}
    </div>

    <div class='education'>
      <h4 class='layout-title'>
        {cv.data.educationName}
      </h4>

      <ul>
        {
          cv.data.education.map((education) => (
            <li>
              <div> {education.title} - {education.date}</div>
              <div>{education.institution}</div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Layout>

<style lang='scss' is:global>
  body {
    background-image: none !important;
    background-color: #f5f5f5 !important;
    color: black !important;
    margin: 0;
    padding: 0;

    @media print {
      background-color: white !important;
      
      a {
        text-decoration: underline !important;
      }
    }
  }

  :root {
    --color-primary: black !important;
    --color-secondary: black !important;
  }

  a {
    text-decoration: underline;

    &:hover {
      text-decoration: none;
    }
  }

  header {
    text-align: left;

    h1 {
      font-size: 1.5rem;
      font-weight: bold;
    text-align: left;


      a {
        text-decoration: none;

        &:hover {
          text-decoration: underline;
        }
      }
    }

    .contact {
      font-size: 0.8rem;
      margin-bottom: 1rem;
      line-height: 1.6;

      @media print {
        white-space: nowrap;
      }
    }

    .role {
      margin-bottom: 0.25rem;
      font-weight: 500;
    }

    .updated {
      color: #666;
      font-size: 0.7rem;
      margin-bottom: 0.5rem;
    }

    hr {
      max-width: 100%;
    }
  }

  nav {
    margin-bottom: 2rem !important;
    display: flex !important;
    justify-content: space-between;
    align-items: center;

    @media print {
      margin-bottom: -2rem !important;
    }

    @media print {
      .langs { 
        display: none !important;
      };
    }

    .icon {
      @media print {
        display: none !important;
      }

      svg {
        width: 2rem;
        height: 2rem;

        &:hover {
          color: var(--color-500);
        }
      }
    }

    .langs {
      display: flex;
      gap: 1rem;
      justify-content: center;
    }

    a {
      font-weight: bold;
    }
  }

  .layout-title {
    font-size: 1.2rem;
    text-align: left;
    font-weight: 700;
    color: #000;
    margin: 1.5rem 0 0.75rem;
  }

  .layout {
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
    padding: 2rem 1rem;
    background-color: white;
    min-height: 100vh;
    
    @media print {
      margin: 0;
      padding: 0;
      max-width: none;
    }
    
    @media (max-width: 768px) {
      padding: 1.5rem 1rem;
    }
    
    @media (max-width: 480px) {
      padding: 1rem 0.75rem;
    }
  }

  .about {
    line-height: 1.55;

    p {
      margin: 0;
    }

    p:not(:first-child) {
      margin-top: 1rem;
    }
  }

  .education {
    ul {
      display: flex;
      flex-direction: row;
      justify-content: left;

      @media (max-width: 768px) {
        flex-direction: column;

        li:not(:first-child) {
          margin-top: 2rem;
        }
      }

      li {
        text-align: left;
        max-width: none;

        .title{
          font-weight: bold;
        }
      }
    }
  }

  .experience {
    ul {
      margin: 0;

      li {
        break-inside: avoid;
        margin-bottom: 1.25rem;

        &:nth-child(3) {
          @media print {
            break-before: page;
          }
        }

        .experience__heading {
          display: flex;
          justify-content: space-between;
          align-items: baseline;
          gap: 1rem;

          h3 {
            font-size: 1rem;
            margin: 0;
          }
        }

        .experience__dates {
          flex: none;
          font-size: 0.8rem;
          white-space: nowrap;
        }

        .experience__type {
          color: #666;
          font-size: 0.75rem;
          margin-top: 0.15rem;
        }

        .experience__about {
          text-align: left;

          p {
            margin: 0.35rem 0 0;
          }
        }

        @media (max-width: 480px) {
          .experience__heading {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.15rem;
          }
        }
      }
    }
  }
</style>
