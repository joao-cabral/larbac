---
import SectionLayout from "../layouts/sectionLayout.astro";
import ProfessionalProjectCard from "../components/ProfessionalProjectCard.astro";
import { professionalProjects } from "../lib/professional-projects";
import PersonalProjectCards from "../components/PersonalProjectCards.astro";




---

<SectionLayout
  title="Trabalhos"
  eyebrow="Experiência profissional"
  description="Produtos e sistemas que ajudei a construir. Explore cada projeto para conhecer o contexto, minha contribuição e as soluções desenvolvidas."
>
  <div class="works-grid professional-grid">
    {professionalProjects.map(project => <ProfessionalProjectCard project={project} headingLevel="h2" />)}
  </div>
  <section class="personal-projects-section">
    <header class="collection-heading">
      <h2>Projetos pessoais</h2>
    </header>
    <div class="works-grid"><PersonalProjectCards /></div>
  </section>


</SectionLayout>

<style lang="scss">
  .professional-grid { container-type: inline-size; }


  .personal-projects-section { margin-top: 64px; }
  .collection-heading { margin-bottom: 24px; }
  .collection-heading h2 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.6rem); letter-spacing: -.05em; }
  .works-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }


  @media (max-width: 760px) {
    .works-grid { grid-template-columns: 1fr; gap: 16px; }

  }

</style>
